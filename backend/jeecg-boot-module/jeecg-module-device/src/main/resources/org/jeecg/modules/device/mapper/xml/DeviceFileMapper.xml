<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.device.mapper.DeviceFileMapper">

    <resultMap id="DeviceFileResultMap" type="org.jeecg.modules.device.entity.DeviceFile">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="category" property="category"/>
        <result column="create_by" property="createBy"/>
        <result column="create_by_name" property="createByName"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectFilesByDeviceId" resultMap="DeviceFileResultMap">
        SELECT
            f.id,
            f.device_id,
            f.file_name,
            f.file_path,
            f.file_size,
            f.file_type,
            f.category,
            f.create_by,
            f.create_time,
            u.realname AS create_by_name
        FROM biz_device_file f
        LEFT JOIN sys_user u ON u.username = f.create_by
        WHERE f.device_id = #{deviceId}
        ORDER BY f.create_time DESC
    </select>

    <delete id="deleteByDeviceId">
        DELETE FROM biz_device_file WHERE device_id = #{deviceId}
    </delete>

</mapper>
